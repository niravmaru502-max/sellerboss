# Public Firebase client configuration (safe for Vercel frontend environment variables)
# In AI Studio, firebase-applet-config.json is loaded automatically as a fallback.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# NOTE: NEVER put Amazon SP-API or Flipkart Seller API secrets here.
# Configure marketplace secrets exclusively in Firebase Cloud Functions Secret Manager:
#   firebase functions:secrets:set AMAZON_LWA_CLIENT_ID
#   firebase functions:secrets:set AMAZON_LWA_CLIENT_SECRET
#   firebase functions:secrets:set AMAZON_REFRESH_TOKEN
#   firebase functions:secrets:set FLIPKART_APP_ID
#   firebase functions:secrets:set FLIPKART_APP_SECRET
